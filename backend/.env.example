# ==========================================
# COWORK30 BACKEND PRODUCTION ENV (MILESWEB)
# Domain: https://v1dev.cowork30.com
# Port: 3001 (Selected from MilesWeb mPanel available ports 3000-3020)
# ==========================================

# Server Port & Environment
PORT=3001
NODE_ENV=production

# Set GLOBAL_PREFIX to "" on MilesWeb because mPanel Proxy Path (api/v1) automatically forwards clean paths
GLOBAL_PREFIX=""

# MySQL Database URL (MilesWeb cPanel Database)
# Format: mysql://cpanel_dbuser:cpanel_dbpassword@localhost:3306/cpanel_dbname
DATABASE_URL="mysql://v1dev_co1_dbuser:YOUR_DB_PASSWORD@localhost:3306/v1dev_co1_db"

# JWT Secret Token
JWT_SECRET="prod_cowork30_milesweb_jwt_secret_token_v1dev_987654321"

# Frontend Origin URL (For CORS Authorization)
FRONTEND_URL="https://v1dev.cowork30.com"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# SMTP Email Credentials
SMTP_HOST="mail.v1dev.cowork30.com"
SMTP_PORT=465
SMTP_USER="no-reply@v1dev.cowork30.com"
SMTP_PASSWORD="YourEmailPassword2026"
SMTP_FROM="Cowork30 Platform <no-reply@v1dev.cowork30.com>"
