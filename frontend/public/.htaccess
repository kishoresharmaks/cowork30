# ==============================================================================
# MilesWeb Apache .htaccess — Frontend Public Reverse Proxy
# Domain: https://v1dev.cowork30.com
# Target Frontend: Port 3000
# Target Backend:  Port 3001
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forward /api/v1 requests to internal NestJS backend on port 3001
  RewriteRule ^api/v1/(.*)$ http://127.0.0.1:3001/api/v1/$1 [P,L]
  RewriteRule ^api/docs/(.*)$ http://127.0.0.1:3001/api/docs/$1 [P,L]
  RewriteRule ^uploads/(.*)$ http://127.0.0.1:3001/uploads/$1 [P,L]
</IfModule>
