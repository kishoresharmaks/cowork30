{
  "name": "cowork30-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Coworking Space Management Platform",
  "scripts": {
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "postinstall": "cd backend && npx prisma generate",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
